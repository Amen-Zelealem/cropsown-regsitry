# ---------------------------------------------------------------------------
# Helm artifacts
# ---------------------------------------------------------------------------
# Chart.lock is regenerated by `helm dependency update/build`. Because this
# wrapper chart pins to a `-develop` tag of openg2p-registry (an ever-moving
# target), the lock provides no real determinism — leave it untracked.
helm/**/Chart.lock
# Subchart tarballs downloaded by `helm dependency build` into <chart>/charts/.
# Vendored uncompressed subcharts (charts/<name>/) remain tracked.
helm/**/charts/*.tgz

crop sown registry ERD.html
master-dat-service-api-responses
# local/ is the local docker-compose dev stack config (Postgres init, Keycloak,
# IAM, id-generator). docker-compose.yml mounts it, so it is committed; only the
# env file with a developer's own values is not (start from local/.env.example).
local/.env
local/*.bak*

# Large seeds, temporary ODK choices, and Celery beat schedules
docker/local-dev/geo-seed/*.gz
odk_choices/
openg2p-connector-service/celerybeat-schedule*

# Pinned helm/kubectl that ci/deploy-dev.sh fetches when the agent has none.
.tools/

# JetBrains / IDE project files
.idea/

# WireGuard peer configs carry a private key. ci/setup-agent-vpn.sh reads one,
# and the README example keeps it in the repo root — never commit it.
/*.conf

# CI checkout of the dashboard service (Jenkinsfile, stage "Checkout dashboard-api").
.build/

# kubeconfig written by ci/k8s/make-crop-ci-kubeconfig.sh (holds a token)
*.kubeconfig
# Partner signing keys (Farmer Registry enrichment), mounted at /run/secrets/cropsown
local/secrets/*
!local/secrets/.gitkeep
